# Supabase (Project settings → API). The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public address of the site, used in links and metadata.
NEXT_PUBLIC_SITE_URL=https://drawing2cad.com

# Razorpay (Dashboard → Account & Settings → API keys; Webhooks → secret). Test keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Telegram ping to the owner when a drawing is uploaded or confirmed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: the conversion engine's endpoint, pinged on job.created / job.confirmed (it can also just poll).
ENGINE_WEBHOOK_URL=
ENGINE_WEBHOOK_SECRET=

# Local only: lets /dev-login sign in admin-created test users. Never set in production.
DEV_LOGIN=
